#!/bin/bash
# ===== 프로그램 업데이트 - 맥. 더블클릭 한 번이면 끝 =====
# GitHub 에서 최신 버전을 받아 이 폴더를 갱신합니다.
# 프로그램 파일만 최신으로 덮어씁니다.
# 만든 음성, 참고목소리, 설치된 환경 .venv, 설정은 그대로 유지됩니다.
# 계정/로그인/토큰은 필요 없습니다. (공개 저장소)
#
# [주의] 이 스크립트는 자기 자신도 최신 버전으로 덮어씁니다.
# 실행 중에 파일이 바뀌면 엉뚱한 줄이 실행될 수 있어서, 전체를 함수로 감싸
# bash 가 파일을 끝까지 읽은 뒤 실행하도록 했습니다. (마지막 줄의 main 호출)

fail() {
  echo ""
  echo "------------------------------------------------------------"
  echo " [오류] 업데이트에 실패했습니다."
  echo "  - 인터넷 연결을 확인한 뒤 다시 실행해 주세요."
  echo "  - 그래도 안 되면 이 창을 화면 캡처해서 보내주세요."
  echo "------------------------------------------------------------"
  read -r -p "엔터를 누르면 창이 닫힙니다..."
  exit 1
}

main() {
  cd "$(dirname "$0")" || exit 1
  REPO_URL="https://github.com/sh200220/foreign-video-tts.git"

  echo "============================================================"
  echo " 프로그램 업데이트"
  echo "============================================================"
  echo ""

  if ! command -v git >/dev/null 2>&1; then
    echo "------------------------------------------------------------"
    echo " 업데이트에 필요한 git 이 이 맥에 없습니다."
    echo " 뜨는 창에서 '설치' 를 눌러 주세요. 몇 분 걸립니다."
    echo " 설치가 끝나면 UPDATE-Mac.command 를 다시 실행하세요."
    echo "------------------------------------------------------------"
    xcode-select --install 2>/dev/null
    read -r -p "엔터를 누르면 창이 닫힙니다..."
    exit 1
  fi

  if [ ! -d ".git" ]; then
    echo "[처음 한 번] 이 폴더를 최신 버전 저장소와 연결합니다..."
    git init >/dev/null 2>&1 || fail
    git remote remove origin >/dev/null 2>&1
    git remote add origin "$REPO_URL" || fail
  fi

  echo "최신 버전을 내려받는 중입니다. 잠시만 기다려 주세요..."
  git fetch origin || fail
  git reset --hard origin/main || fail

  echo ""
  echo "============================================================"
  echo " 업데이트 완료!"
  echo " 이 창을 닫고 START-Mac.command 로 실행하세요."
  echo " 새 기능에 필요한 것은 시작할 때 자동으로 설치됩니다."
  echo "============================================================"
  read -r -p "엔터를 누르면 창이 닫힙니다..."
  exit 0
}

main "$@"
